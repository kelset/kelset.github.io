---

<ul>
  {
    items.map((s) => (
      <li>
        <a href={s.url} rel={s.url.startsWith("mailto:") ? undefined : "me noopener"} aria-label={s.label}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width={size}
            height={size}
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            {ICONS[s.icon].map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Colours come from two custom properties so a sign band can restyle the row
     from outside — a parent's scoped rule can't reach in here, but a custom
     property inherits straight through. */
  ul {
    list-style: none;
    margin: 0 -10px;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  /* 40px targets around 20px marks */
  a {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    color: var(--social, var(--ink-soft));
    transition:
      color 140ms var(--ease),
      transform 180ms var(--ease);
  }

  a:hover {
    color: var(--social-hi, var(--ink));
    transform: translateY(-2px);
  }

  a:focus-visible {
    outline-color: var(--social-hi, var(--ink));
    outline-offset: -2px;
  }
</style>
