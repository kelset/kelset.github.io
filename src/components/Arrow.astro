---
/* The site's one arrow. Inline SVG, because the webfont has no arrow glyphs —
   see scripts/subset-fonts.mjs. Decorative: the link text carries the meaning. */
interface Props {
  dir?: "right" | "left";
}
const { dir = "right" } = Astro.props;
---

<svg
  class="arrow"
  viewBox="0 0 22 14"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={dir === "left" ? "rotate:180deg" : undefined}
>
  <path d="M1 7h19M14 1l6 6-6 6"></path>
</svg>
