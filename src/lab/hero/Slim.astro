---
/* Map first: identity becomes one compact row, so the map — the thing the
   page is actually about — starts almost at the top. */
import Boop from "../../components/Boop.astro";
import Actions from "../../components/HeroActions.astro";
import { PROFILE, SITE } from "../../data/site";
---

<section class="wrap slim">
  <div class="id">
    <Boop look="ring" caption="hidden" />
    <div>
      <h1>{SITE.name}</h1>
      <p class="eyebrow">{PROFILE.role} at {PROFILE.employer} · {PROFILE.location}</p>
    </div>
  </div>
  <p class="sum">{PROFILE.summary}</p>
  <Actions />
</section>

<style>
  .slim {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px clamp(24px, 3.5vw, 52px);
    padding-block: clamp(22px, 3vw, 36px);
    --boop-size: 76px;
  }

  .id {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  h1 {
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem);
    font-stretch: 118%;
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-block-end: 6px;
    white-space: nowrap;
  }

  .sum {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.45;
    max-inline-size: 34em;
    text-wrap: pretty;
  }

  .slim :global(.actions) {
    flex-direction: column;
  }

  @media (max-width: 1040px) {
    .slim {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .sum {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 640px) {
    .slim {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      padding-block: 18px 22px;
      --boop-size: 64px;
    }

    .id {
      gap: 12px;
    }

    h1 {
      /* one line beside the doodle: the column minus the doodle and its gap */
      font-size: calc((100vw - 2 * var(--gutter) - 76px) * 0.092);
    }

    .slim :global(.actions) {
      flex-direction: row;
    }
  }
</style>
