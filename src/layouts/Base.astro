---
import "../styles/global.css";
import fontWoff2 from "../assets/fonts/archivo-subset.woff2?url";
import italicWoff2 from "../assets/fonts/archivo-italic-subset.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, type NavId } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** absolute URL of the social image; defaults to the share card
      (public/og.png — see scripts/og-card.mjs) */
  ogImage?: string;
  ogType?: "website" | "article";
  /** extra JSON-LD blocks */
  schema?: Record<string, unknown>[];
  /** which exit on the header sign reads as "you are here" */
  current?: NavId;
  /** preload the italic face — worth it only where prose actually uses it */
  italic?: boolean;
  /** keep the page out of search indexes — the lab and the 404 */
  noindex?: boolean;
}

/* the default card's size is known, so crawlers can lay it out before
   fetching it; an article's cover keeps whatever shape it has */
const defaultCard = Astro.props.ogImage === undefined;

const {
  title,
  description,
  ogImage = new URL("/og.png", Astro.site).href,
  ogType = "website",
  schema = [],
  current,
  italic = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle =
  Astro.url.pathname === "/" ? `${SITE.title} — ${SITE.name}` : `${title} · ${SITE.title}`;

/* The font is preloaded and declared font-display: optional — it never delays
   first paint or shifts layout; a slow first visit renders the system stack,
   every later visit renders Archivo from cache. */
const latinRange =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const fontFaces = `
@font-face{font-family:"Archivo Variable";font-style:normal;font-display:optional;font-weight:400 900;font-stretch:62% 125%;src:url(${fontWoff2}) format("woff2-variations");unicode-range:${latinRange}}
@font-face{font-family:"Archivo Variable";font-style:italic;font-display:optional;font-weight:400 700;src:url(${italicWoff2}) format("woff2-variations");unicode-range:${latinRange}}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" as="font" type="font/woff2" href={fontWoff2} crossorigin />
    {italic && <link rel="preload" as="font" type="font/woff2" href={italicWoff2} crossorigin />}
    <style set:html={fontFaces}></style>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — blog`} href="/rss.xml" />
    {/* the header sign is the top edge of the page in both themes */}
    {/* --sign-bg in sRGB hex, day and night; re-measure if the token moves */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0f141d" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#181f2e" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {defaultCard && <meta property="og:image:width" content="1200" />}
    {defaultCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={defaultCard ? `${SITE.name} — ${SITE.domain}` : title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="fediverse:creator" content="@kelset@mastodon.online" />

    <script is:inline>
      // Theme no-flash: apply the stored choice before first paint. Also maps
      // the values earlier versions of the site wrote, so a returning visitor
      // keeps a dark or light pick instead of silently falling back to the OS.
      (() => {
        const legacy = {
          "kelset-dark": "dark",
          "tokyo-night": "dark",
          "kelset-light": "light",
          "catppuccin-latte": "light",
        };
        try {
          const raw = localStorage.getItem("theme");
          const t = legacy[raw] || raw;
          if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>

    {schema.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
